# Default GitHub fine-grained token, used for any repo below without its own override
GITHUB_TOKEN=
GITHUB_REPO_SUSTENTUS=sustentus/sustentus
# Set this to the exact owner/repository slug, for example apoyar/serviflow
GITHUB_REPO_SERVIFLOW=
STATS_REFRESH_MINUTES=30

# Bleckmann repository, when connected
GITHUB_REPO_BLECKMANN=

# Fine-grained PATs are scoped to a single resource owner (a user or an org).
# If a repo above is owned by a different account than GITHUB_TOKEN's owner,
# set its own token here instead of relying on the shared GITHUB_TOKEN.
GITHUB_TOKEN_SUSTENTUS=
GITHUB_TOKEN_SERVIFLOW=
GITHUB_TOKEN_BLECKMANN=
